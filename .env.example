PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
# Generate a long random secret; never commit real secrets.
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
JWT_SECRET=replace-with-a-long-random-secret

# Supabase (optional in local demo; required for shared persistent records/auth rollout)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (optional; local disk is used when these are blank)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autoclip-media
R2_PUBLIC_BASE_URL=

# Upload and processing limits
MAX_UPLOAD_MB=500
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=30
WATERMARK_TEXT=AUTOCLIP AI

# Optional AI clipping (OpenAI API usage is billed separately)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_HIGHLIGHT_MODEL=gpt-4o-mini
